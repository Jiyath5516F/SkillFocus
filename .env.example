# Copy to .env (never commit .env). The server loads it automatically.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Optional: in the Claude Code cloud container use SKILLFOCUS_ANTHROPIC_API_KEY instead (takes precedence).
# SKILLFOCUS_ANTHROPIC_API_KEY=
MIRA_MODEL=claude-opus-5-5
MIRA_EFFORT=low
PORT=8090
HOST=127.0.0.1
# Serve under a sub-path, e.g. https://<host>/Mira  (also set at build time: MIRA_BASE_PATH=/Mira npm run build)
MIRA_BASE_PATH=
MIRA_DB_PATH=data/mira.db
